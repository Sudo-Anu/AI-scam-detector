@echo off
setlocal EnableDelayedExpansion
title AI Scam Detector -- Launcher

:: ANSI colour helpers
for /f %%a in ('echo prompt $E^| cmd /q') do set "ESC=%%a"
set "GREEN=%ESC%[92m"
set "YELLOW=%ESC%[93m"
set "RED=%ESC%[91m"
set "CYAN=%ESC%[96m"
set "BOLD=%ESC%[1m"
set "RESET=%ESC%[0m"

:: Project paths  (strip trailing backslash from %~dp0)
set "ROOT=%~dp0"
if "!ROOT:~-1!"=="\" set "ROOT=!ROOT:~0,-1!"
set "BACKEND=!ROOT!\backend"
set "FRONTEND=!ROOT!\frontend"
set "VENV=!BACKEND!\venv"
set "REQUIREMENTS=!BACKEND!\requirements.txt"
set "ENV_FILE=!ROOT!\.env"

:: Helper scripts live in %TEMP% which Windows always expands to the
:: 8.3 short path (e.g. C:\Users\ANIRUD~1\AppData\Local\Temp) -- NO spaces.
set "_BK=%TEMP%\scam_backend.bat"
set "_FE=%TEMP%\scam_frontend.bat"

echo.
echo !BOLD!!CYAN!AI Scam Detector Setup and Runner !RESET!
echo.

:: ?????? [1/6] Python ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo !YELLOW![1/6]!RESET! Checking Python...
where python >nul 2>&1
if errorlevel 1 (
    echo !RED![ERROR]!RESET! Python not found. Install 3.10+ from https://python.org
    pause & exit /b 1
)
for /f "tokens=*" %%v in ('python --version 2^>^&1') do set "PYVER=%%v"
echo !GREEN![OK]!RESET! !PYVER! detected.

:: ?????? [2/6] Node / npm ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo !YELLOW![2/6]!RESET! Checking Node.js / npm...
where node >nul 2>&1
if errorlevel 1 (
    echo !RED![ERROR]!RESET! Node.js not found. Install 18+ from https://nodejs.org
    pause & exit /b 1
)
where npm >nul 2>&1
if errorlevel 1 (
    echo !RED![ERROR]!RESET! npm not found in PATH.
    pause & exit /b 1
)
for /f "tokens=*" %%v in ('node --version 2^>^&1') do set "NODEVER=%%v"
for /f "tokens=*" %%v in ('npm --version 2^>^&1')  do set "NPMVER=%%v"
echo !GREEN![OK]!RESET! Node.js !NODEVER! / npm v!NPMVER! detected.

:: ?????? [3/6] Virtual environment ?????????????????????????????????????????????????????????????????????????????????????????????
echo !YELLOW![3/6]!RESET! Checking Python virtual environment...
if exist "!VENV!\Scripts\activate.bat" (
    echo !GREEN![OK]!RESET! venv found -- activating...
) else (
    echo !YELLOW![INFO]!RESET! venv missing -- creating at backend\venv...
    python -m venv "!VENV!"
    if errorlevel 1 (
        echo !RED![ERROR]!RESET! Failed to create venv.
        pause & exit /b 1
    )
    echo !GREEN![OK]!RESET! venv created.
)
call "!VENV!\Scripts\activate.bat"
echo !GREEN![OK]!RESET! venv activated.

:: ?????? [4/6] Python dependencies ?????????????????????????????????????????????????????????????????????????????????????????????
echo !YELLOW![4/6]!RESET! Installing / verifying Python dependencies...
echo         (First run may take several minutes -- EasyOCR is large)
python -m pip install --upgrade pip --quiet
python -m pip install -r "!REQUIREMENTS!" --quiet
if errorlevel 1 (
    echo !RED![ERROR]!RESET! pip install failed. Check network / requirements.txt.
    pause & exit /b 1
)
echo !GREEN![OK]!RESET! All Python dependencies satisfied.

:: ?????? [5/6] npm dependencies ??????????????????????????????????????????????????????????????????????????????????????????????????????
echo !YELLOW![5/6]!RESET! Checking frontend npm dependencies...
if not exist "!FRONTEND!\node_modules" (
    echo !YELLOW![INFO]!RESET! node_modules missing -- running npm install...
    pushd "!FRONTEND!"
    npm install --silent
    if errorlevel 1 (
        echo !RED![ERROR]!RESET! npm install failed.
        popd & pause & exit /b 1
    )
    popd
    echo !GREEN![OK]!RESET! npm packages installed.
) else (
    echo !GREEN![OK]!RESET! node_modules already present.
)

:: ?????? [6/6] API keys ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo !YELLOW![6/6]!RESET! Verifying API keys in .env...
if not exist "!ENV_FILE!" (
    echo # AI Scam Detector>"!ENV_FILE!"
    echo GEMINI_API_KEY=>>"!ENV_FILE!"
    echo VIRUSTOTAL_API_KEY=>>"!ENV_FILE!"
    echo GOOGLE_API_KEY=>>"!ENV_FILE!"
)
call :CHECK_KEY "GEMINI_API_KEY"     "Gemini API Key"
call :CHECK_KEY "VIRUSTOTAL_API_KEY" "VirusTotal API Key"
call :CHECK_KEY "GOOGLE_API_KEY"     "Google API Key"
echo !GREEN![OK]!RESET! All API keys present in .env.

:: ?????? Write helper scripts into %TEMP% ????????????????????????????????????????????????????????????????????????
::    %TEMP% always resolves to the 8.3 short path on Windows,
::    so there are NO spaces -- cmd /k "%_BK%" works perfectly.
(
    echo @echo off
    echo title ScamDetector-Backend
    echo cd /d "!ROOT!"
    echo call "!VENV!\Scripts\activate.bat"
    echo echo.
    echo echo  Backend: http://127.0.0.1:8000  ^(docs: /docs^)
    echo echo.
    echo python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload
) > "!_BK!"

(
    echo @echo off
    echo title ScamDetector-Frontend
    echo cd /d "!FRONTEND!"
    echo echo.
    echo echo  Frontend: http://localhost:5173
    echo echo.
    echo npm run dev
) > "!_FE!"

:: ?????? Launch both servers ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo.
echo !BOLD!!CYAN!Launching servers...!RESET!
echo.

start "ScamDetector-Backend"  /MIN cmd /k "%_BK%"
echo !GREEN![OK]!RESET! Backend window started.

timeout /t 5 /nobreak >nul

start "ScamDetector-Frontend" /MIN cmd /k "%_FE%"
echo !GREEN![OK]!RESET! Frontend window started.

timeout /t 6 /nobreak >nul

:: ?????? Open browser ???????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo.
echo !BOLD!!CYAN!  Backend API  --^>  http://127.0.0.1:8000/docs!RESET!
echo !BOLD!!CYAN!  Frontend     --^>  http://localhost:5173!RESET!
echo.
start "" "http://localhost:5173"

echo !BOLD!Both servers are running in minimised windows.!RESET!
echo Close "ScamDetector-Backend" and "ScamDetector-Frontend" to stop.
echo.
pause
exit /b 0


:: ============================================================
:: SUBROUTINE :CHECK_KEY  "<KEY_NAME>"  "<Display Label>"
::   Reads .env, checks value. Prompts + rewrites if missing.
:: ============================================================
:CHECK_KEY
set "_KEY=%~1"
set "_LABEL=%~2"
set "_VALUE="
for /f "usebackq tokens=1,* delims==" %%A in ("!ENV_FILE!") do (
    if /i "%%A"=="!_KEY!" set "_VALUE=%%B"
)
if defined _VALUE set "_VALUE=!_VALUE: =!"
if not defined _VALUE (
    echo.
    echo !YELLOW!  [MISSING]!RESET! !_LABEL! ^(!_KEY!^) is not set.
    set /p "_NEW=  Enter !_LABEL!: "
    if "!_NEW!"=="" (
        echo !RED!  [WARN] Skipped -- some features may not work.!RESET!
        goto :EOF
    )
    set "_FOUND=0"
    set "_TMP=!ENV_FILE!.tmp"
    if exist "!_TMP!" del /f /q "!_TMP!"
    for /f "usebackq delims=" %%L in ("!ENV_FILE!") do (
        set "_LINE=%%L"
        echo !_LINE! | findstr /b /i "!_KEY!=" >nul 2>&1
        if !errorlevel!==0 (
            echo !_KEY!=!_NEW!>>"!_TMP!"
            set "_FOUND=1"
        ) else (
            echo !_LINE!>>"!_TMP!"
        )
    )
    if "!_FOUND!"=="0" echo !_KEY!=!_NEW!>>"!_TMP!"
    move /y "!_TMP!" "!ENV_FILE!" >nul
    echo !GREEN!  [SAVED]!RESET! !_KEY! written to .env.
) else (
    echo !GREEN!  [OK]!RESET!  !_KEY! is set.
)
goto :EOF